---
import { base, htmlLang, ui, type Lang } from '../i18n';
import { profile } from '../data/profile';
import '../styles/global.css';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  // Same page in the other language, for the language switch.
  altHref: string;
  // False when altHref is not a translation of this page (e.g. a post that
  // only exists in one language); hreflang must only pair true translations.
  translated?: boolean;
  // Extra JSON-LD nodes for this page (e.g. a BlogPosting).
  jsonLd?: Record<string, unknown>[];
  // Keep the page out of search results (404).
  noindex?: boolean;
}

const { lang, title, description, altHref, translated = true, jsonLd = [], noindex = false } = Astro.props;
const t = ui[lang];
const fullTitle = title ? `${title} · ${profile.name}` : profile.name;
const desc = description ?? profile[lang].tagline;
const other: Lang = lang === 'zh' ? 'en' : 'zh';
const isBlog = Astro.url.pathname.includes('/blog/');
const personId = new URL('/#person', Astro.site).href;
const person = {
  '@type': 'Person',
  '@id': personId,
  name: profile.name,
  jobTitle: lang === 'zh' ? '生成式 AI 工程師' : 'Generative AI Engineer',
  url: Astro.site?.toString(),
  email: profile.email ? `mailto:${profile.email}` : undefined,
  sameAs: profile.links.map((l) => l.href),
  knowsAbout: ['Generative AI', 'Edge AI', 'Computer Vision', 'LLM', 'Inference Optimization'],
  alumniOf: ['National Chiao Tung University', 'National Central University'],
};
// The home pages are profile pages about the person; every page carries the
// Person node so posts can point their author at it by @id.
const isHome = Astro.url.pathname === base[lang];
const graph = {
  '@context': 'https://schema.org',
  '@graph': [
    person,
    ...(isHome
      ? [{ '@type': 'ProfilePage', url: new URL(Astro.url.pathname, Astro.site).href, mainEntity: { '@id': personId }, inLanguage: htmlLang[lang] }]
      : []),
    ...jsonLd.map((node) => ({ author: { '@id': personId }, ...node })),
  ],
};
const self = new URL(Astro.url.pathname, Astro.site);
const zhHref = lang === 'zh' ? self : new URL(altHref, Astro.site);
---

<!doctype html>
<html lang={htmlLang[lang]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#f2f3ef" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#131a22" media="(prefers-color-scheme: dark)" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Noto+Serif+TC:wght@400;600&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;1,8..60,400&display=swap"
    />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={self} />
    {translated && !noindex && (
      <>
        <link rel="alternate" hreflang={htmlLang[lang]} href={self} />
        <link rel="alternate" hreflang={htmlLang[other]} href={new URL(altHref, Astro.site)} />
        <link rel="alternate" hreflang="x-default" href={zhHref} />
      </>
    )}
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:locale" content={lang === 'zh' ? 'zh_TW' : 'en_US'} />
    <meta name="twitter:card" content="summary" />
    <script type="application/ld+json" set:html={JSON.stringify(graph).replace(/</g, '\\u003c')} />
  </head>
  <body>
    <header class="site-header">
      <nav class="wrap">
        <a class="brand" href={base[lang]}>{profile.name}</a>
        <div class="nav-links">
          <a href={`${base[lang]}blog/`} aria-current={isBlog ? 'page' : undefined}>{t.blog}</a>
          <a href="https://fezone.tw">FEZone</a>
          <a href={altHref} hreflang={htmlLang[other]} lang={htmlLang[other]}>{t.switchLang}</a>
        </div>
      </nav>
    </header>
    <main class="wrap">
      <slot />
    </main>
    <footer class="site-footer wrap">
      <span>© {new Date().getFullYear()} {profile.name}</span>
      <a href={profile.github}>GitHub</a>
      <a href="https://ko-fi.com/fezonetw">☕ Ko-fi</a>
    </footer>
  </body>
</html>
