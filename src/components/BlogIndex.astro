---
import Base from '../layouts/Base.astro';
import PostList from './PostList.astro';
import { base, ui, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const other: Lang = lang === 'zh' ? 'en' : 'zh';
---

<Base lang={lang} title={ui[lang].blog} altHref={`${base[other]}blog/`}>
  <div class="page">
    <h1>{ui[lang].blog}</h1>
    <div class="page-list"><PostList lang={lang} /></div>
  </div>
</Base>
